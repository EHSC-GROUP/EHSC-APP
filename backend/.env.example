PORT=5000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Firebase (emulator mode - see README for setup)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_PROJECT_ID=hr-app-local
FIREBASE_STORAGE_BUCKET=hr-app-local.appspot.com

# Company details used on payslip / statutory PDFs
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_ADDRESS=Address line, City, State, PIN
