PORT=5000
NODE_ENV=development

# Generate with: openssl rand -base64 48  (must be 32+ characters — the
# server refuses to start with a shorter one)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call this API (the deployed
# frontend's URL, e.g. https://hr.ehsconsultantsgroup.org). Leave unset for
# local dev; server.js REFUSES to start in production without it.
CORS_ORIGIN=

# Firebase (emulator mode - see README for setup). In production, remove
# the two *_EMULATOR_HOST lines entirely (server.js refuses to start in
# production if FIRESTORE_EMULATOR_HOST is set), point FIREBASE_PROJECT_ID /
# FIREBASE_STORAGE_BUCKET at the real project, and provide credentials via
# GOOGLE_APPLICATION_CREDENTIALS (a service account JSON) or the platform's
# built-in service account (Cloud Run, GCE, etc).
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_PROJECT_ID=hr-app-local
FIREBASE_STORAGE_BUCKET=hr-app-local.appspot.com

# Company details used on payslip / statutory PDFs
COMPANY_NAME=Your Company Pvt Ltd
COMPANY_ADDRESS=Address line, City, State, PIN

# Optional — only read by scripts/seed.js when bootstrapping the very first
# superadmin. Leave unset to use the app's standard temporary password
# (must be changed at first login either way).
SEED_SUPERADMIN_ID=SUPERADMIN
SEED_SUPERADMIN_PASSWORD=
